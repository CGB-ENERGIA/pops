# ID do diretório (tenant) do Azure AD da CGB — encontrado na página de visão
# geral do app registrado ("Directory (tenant) ID").
MS_TENANT_ID=coloque_o_tenant_id_aqui

# ID do aplicativo (client) registrado no Azure AD.
MS_CLIENT_ID=coloque_o_client_id_aqui

# Client secret gerado para o app (aba "Certificates & secrets"). Guarde com
# cuidado, ele não pode ser recuperado depois de criado — só recriado.
MS_CLIENT_SECRET=coloque_o_client_secret_aqui

# Link de compartilhamento da pasta raiz dos POPs no OneDrive/SharePoint
# (o mesmo link que você abre no navegador para acessar a pasta).
MS_SHARE_URL=https://cgbengenharia-my.sharepoint.com/:f:/g/personal/....

# Senha para proteger a rota /auth/login (usada só uma vez, por você, para
# autorizar o app com sua conta Microsoft). Invente uma string qualquer.
AUTH_SETUP_SECRET=escolha-uma-senha-forte-aqui

# Credenciais do Redis (Upstash) usado para guardar a sessão de login entre
# execuções do servidor. Crie um banco em vercel.com → Storage → Redis (ou
# Upstash Marketplace) e copie estes dois valores do painel.
KV_REST_API_URL=coloque_a_url_aqui
KV_REST_API_TOKEN=coloque_o_token_aqui
