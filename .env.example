# E-mail da service account criada no Google Cloud Console
GOOGLE_CLIENT_EMAIL=nome-da-conta@seu-projeto.iam.gserviceaccount.com

# Chave privada da service account (do JSON baixado), mantendo as quebras de linha como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID da pasta raiz no Google Drive (o trecho depois de /folders/ na URL da pasta)
GOOGLE_ROOT_FOLDER_ID=coloque_o_id_da_pasta_aqui
